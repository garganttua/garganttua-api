<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-dao</artifactId>
		<version>3.0.0-ALPHA01</version>
	</parent>
	<artifactId>garganttua-api-dao-mongodb</artifactId>
	<description>MongoDB DAO implementation — native-ready repository backed by the MongoDB driver.</description>

	<dependencies>
		<!-- Garganttua API -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-commons</artifactId>
		</dependency>

		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-binding-mongodb</artifactId>
		</dependency>

		<!-- AOT support. The @Reflected annotation processor emits AOTClass_*
		     descriptors into target/generated-sources/annotations referencing
		     com.garganttua.core.aot.reflection, so that artefact is needed on the
		     compile + runtime classpath. aot-commons carries the
		     IAOTInfrastructureSeed SPI implemented by MongoDaoInfrastructureSeed. -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-commons</artifactId>
		</dependency>
	</dependencies>
</project>

			</dependency>
			<dependency>
				<groupId>com.garganttua.core</groupId>
				<artifactId>garganttua-crypto</artifactId>
				<version>${garganttua.core.version}</version>
			</dependency>

			<!-- Garganttua API bindings — each wraps one external lib. -->
			<dependency>
				<groupId>com.garganttua</groupId>
				<artifactId>garganttua-api-binding-jackson</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.garganttua</groupId>
				<artifactId>garganttua-api-binding-slf4j</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.garganttua</groupId>
				<artifactId>garganttua-api-binding-jsonpath</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.garganttua</groupId>
				<artifactId>garganttua-api-binding-mongodb</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.garganttua</groupId>
				<artifactId>garganttua-api-binding-javalin</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Standalone third-party deps reintroduced directly (kept
			     outside bindings on user's instruction). -->
			<dependency>
				<groupId>org.javatuples</groupId>
				<artifactId>javatuples</artifactId>
				<version>${javatuples.version}</version>
			</dependency>
			<dependency>
				<groupId>jakarta.inject</groupId>
				<artifactId>jakarta.inject-api</artifactId>
				<version>${jakarta-inject.version}</version>
			</dependency>
			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-core</artifactId>
				<version>${mockito.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.mockito</groupId>
				<artifactId>mockito-junit-jupiter</artifactId>
				<version>${mockito.version}</version>
				<scope>test</scope>
			</dependency>

			<!-- Third-party dependencies intentionally absent.
			     The api restricts itself to the garganttua ecosystem
			     (com.garganttua / com.garganttua.core). Every external
			     binding — lombok, slf4j-*, jackson-*, json-path,
			     javatuples, reflections, geojson, javax.inject, junit,
			     mockito, etc. — is delegated to dedicated binding
			     sub-modules to be introduced later. Until those bindings
			     land, downstream consumers must declare third-party deps
			     themselves. -->
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<source>${java.version}</source>
						<target>${java.version}</target>
						<compilerArgs>
							<arg>-parameters</arg>
							<!-- Level 2 AOT: instructs garganttua-aot-annotation-processor's
								 DirectBinderGenerator to emit AOTClass_*/AOTField_*/AOTMethod_*
								 source files for every @Reflected type, registered into
								 AOTRegistry via static initialisers. Pairs with the
								 Level 1 @Indexed APT below — both processors live in the
								 same jar, but DirectBinderGenerator is gated by this
								 option whereas IndexedAnnotationProcessor always runs. -->
							<arg>-Agarganttua.direct.binders=true</arg>
						</compilerArgs>
						<annotationProcessorPaths>
							<!-- Lombok APT path removed alongside the rest of the
							     third-party purge — to be reintroduced as part of a
							     lombok binding sub-module. -->

							<!-- Level 1: @Indexed annotation index generation.
								 Level 2: @Reflected direct binder generation
								 (gated by -Agarganttua.direct.binders=true above). -->
							<path>
								<groupId>com.garganttua.core</groupId>
								<artifactId>garganttua-aot-annotation-processor</artifactId>
								<version>${garganttua.core.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<plugin>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<!-- Mockito's ByteBuddy doesn't yet officially recognise the
						     Java 25 (class file v69) runtime the project now builds on;
						     enable ByteBuddy's experimental mode so mock generation works.
						     Follow-up: bump Mockito + ByteBuddy to JDK-25-native versions
						     and drop this flag. -->
						<argLine>-Dnet.bytebuddy.experimental=true</argLine>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>${maven-source-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<modules>
		<module>garganttua-api-bindings</module>
		<module>garganttua-api-commons</module>
		<module>garganttua-api-core</module>
		<module>garganttua-api-dao</module>
		<module>garganttua-api-starters</module>
		<!-- <module>garganttua-api-security</module>
		<module>garganttua-api-interface</module> -->
		<!-- <module>garganttua-api-javalin</module> -->
		<!-- <module>garganttua-api-native-image</module> -->
	</modules>

	<profiles>
		<!-- Opt-in code-size gate (WARNING ONLY — never fails the build). Kept out
		     of the default build so offline builds don't need the Checkstyle
		     artifacts. Activate with `-Pquality`:
		       mvn -Pquality checkstyle:checkstyle   # human-readable worklist
		       mvn -Pquality verify                  # passive gate, writes XML
		     Tracks the god-class / long-method debt and guards against regression. -->
		<profile>
			<id>quality</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-checkstyle-plugin</artifactId>
						<version>3.6.0</version>
						<dependencies>
							<dependency>
								<groupId>com.puppycrawl.tools</groupId>
								<artifactId>checkstyle</artifactId>
								<version>10.21.0</version>
							</dependency>
						</dependencies>
						<configuration>
							<configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
							<includeTestSourceDirectory>false</includeTestSourceDirectory>
							<failOnViolation>false</failOnViolation>
							<violationSeverity>ignore</violationSeverity>
							<consoleOutput>false</consoleOutput>
						</configuration>
						<executions>
							<execution>
								<id>checkstyle-size-gate</id>
								<phase>verify</phase>
								<goals><goal>check</goal></goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>

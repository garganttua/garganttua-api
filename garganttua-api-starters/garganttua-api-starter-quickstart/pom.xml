<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-starters</artifactId>
		<version>3.0.0-ALPHA01</version>
	</parent>
	<artifactId>garganttua-api-starter-quickstart</artifactId>
	<packaging>jar</packaging>

	<!--
	  Quickstart — the minimal set of dependencies to get an IApi up and
	  serving in-process, suitable for tutorials, scripted demos and
	  integration tests:

	    * garganttua-api-core              — the framework itself
	    * garganttua-runtime-reflection    — runtime IReflectionProvider
	    * garganttua-reflections           — IAnnotationScanner backed by
	                                         org.reflections

	  No DAO, no transport, no security — the user supplies an in-memory
	  Map-backed IDao inline and exercises the API in-process via
	  apiBuilder.build().request(...).execute(). For anything beyond a demo,
	  switch to the jvm-mongo-javalin starter (or AOT variant).

	  Wiring:

	      IApi api = ApiBuilder.builder()
	          .multiTenant(false)
	          .domain(IClass.getClass(User.class))
	              .entity().id("id").uuid("uuid").tenantId("tenantId").up()
	              .dto(IClass.getClass(UserDto.class))
	                  .id("id").uuid("uuid").tenantId("tenantId")
	                  .db(new MyInMemoryDao())   // user-provided
	              .up()
	          .up()
	          .build();
	-->

	<dependencies>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-core</artifactId>
		</dependency>

		<!-- Reflection: runtime stack (no AOT processing required). -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-runtime-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-reflections</artifactId>
		</dependency>
	</dependencies>
</project>

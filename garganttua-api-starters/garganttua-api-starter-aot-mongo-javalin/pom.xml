<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-starters</artifactId>
		<version>3.0.0-ALPHA01</version>
	</parent>
	<artifactId>garganttua-api-starter-aot-mongo-javalin</artifactId>
	<packaging>jar</packaging>
	<description>AOT/native starter: MongoDB + Javalin, GraalVM-ready.</description>

	<!--
	  aot-mongo-javalin — same stack as jvm-mongo-javalin but with the AOT
	  reflection provider/scanner ahead of the runtime ones. Use this when
	  building for GraalVM native-image or anywhere classpath scanning at
	  startup is too expensive.

	    * garganttua-api-core               — the framework
	    * garganttua-aot-reflection         — IReflectionProvider backed by
	                                          metadata produced at compile
	                                          time (garganttua-aot-maven-plugin)
	    * garganttua-aot-annotation-scanner — matching IAnnotationScanner
	    * garganttua-runtime-reflection     — runtime fallback when an
	                                          element was not seen during
	                                          AOT processing
	    * garganttua-reflections            — runtime scanner fallback
	    * garganttua-api-dao-mongodb        — MongoDB IDao
	    * garganttua-api-javalin            — TODO: pending 3.0 port
	    * garganttua-api-interface-rest     — TODO: pending 3.0 port
	    * garganttua-api-security           — TODO: pending 3.0 port

	  AOT processing is opt-in: add the garganttua-aot-maven-plugin to your
	  application's build to populate the AOT index. Without that plugin,
	  the AOT provider returns nothing and the runtime fallback kicks in —
	  so this starter is a no-op upgrade over the jvm variant until you
	  enable the plugin.
	-->

	<dependencies>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-core</artifactId>
		</dependency>

		<!-- Reflection: AOT first, runtime fallback. SPI ordering in the
		     ReflectionBuilder gives the higher-priority AOT provider/scanner
		     precedence when both are on the classpath. -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-annotation-scanner</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-runtime-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-reflections</artifactId>
		</dependency>

		<!-- Persistence: MongoDB. -->
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-dao-mongodb</artifactId>
		</dependency>

		<!--
		  TODO: enable once the modules are ported to 3.0.
		  <dependency>
		      <groupId>com.garganttua</groupId>
		      <artifactId>garganttua-api-javalin</artifactId>
		  </dependency>
		  <dependency>
		      <groupId>com.garganttua</groupId>
		      <artifactId>garganttua-api-interface-rest</artifactId>
		  </dependency>
		  <dependency>
		      <groupId>com.garganttua</groupId>
		      <artifactId>garganttua-api-security</artifactId>
		  </dependency>
		-->
	</dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-starters</artifactId>
		<version>3.0.0-ALPHA01</version>
	</parent>
	<artifactId>garganttua-api-starter-aot-mongo-javalin</artifactId>
	<packaging>jar</packaging>
	<description>AOT/native starter: same stack as jvm-mongo-javalin but with AOT reflection
		providers ahead of the runtime ones (GraalVM-ready).</description>

	<!--
	  aot-mongo-javalin — identical stack to jvm-mongo-javalin, but adds the AOT
	  reflection provider/scanner so garganttua-core's Bootstrap ServiceLoader
	  picks them ahead of the runtime ones. The runner is unchanged — provider
	  precedence is decided purely by classpath contents.

	  AOT processing is opt-in: add the garganttua-aot-maven-plugin to your
	  application's build to populate the AOT index. Without it, the AOT provider
	  returns nothing and the runtime fallback kicks in — so this starter is a
	  no-op upgrade over the jvm variant until you enable the plugin.
	-->

	<dependencies>
		<!-- AOT reflection first; the bootstrap starter still brings the runtime
		     fallback (garganttua-runtime-reflection + garganttua-reflections). -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-aot-annotation-scanner</artifactId>
		</dependency>

		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-starter-bootstrap</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-starter-mongodb</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-starter-javalin</artifactId>
		</dependency>
	</dependencies>
</project>

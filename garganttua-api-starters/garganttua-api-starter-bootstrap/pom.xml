<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-starters</artifactId>
		<version>3.0.0-ALPHA01</version>
	</parent>
	<artifactId>garganttua-api-starter-bootstrap</artifactId>
	<packaging>jar</packaging>
	<description>Bootstrap starter: a Spring-Boot-style runner (GarganttuaApplication.run) that
		assembles the framework, scans @Entity/@Dto, runs ServiceLoader auto-configs and reads
		application.yaml — transport- and persistence-agnostic (no Mongo, no Javalin).</description>

	<!--
	  garganttua-api-starter-bootstrap — the SOCLE. It carries the Java that
	  turns the framework into a one-call boot experience:

	    * GarganttuaApplication.run(App.class, args)  — drives core's Bootstrap
	      (which installs IReflection + auto-wires the injection/expression/
	      runtimes/scripts/workflows builders via ServiceLoader), then onInit/
	      onStart.
	    * GarganttuaConfig — reads application.yaml / application.properties +
	      environment-variable overrides (implements commons' IConfig).
	    * Discovers IApiAutoConfiguration services and applies them before build.

	  It brings the framework + the RUNTIME reflection stack only. Persistence
	  (mongodb) and transport (javalin) are separate add-on starters that
	  auto-wire themselves when present. The AOT aggregator simply adds the AOT
	  reflection providers ahead of the runtime ones — the runner is unchanged.
	-->

	<dependencies>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-core</artifactId>
		</dependency>

		<!-- Reflection: runtime stack (no AOT step required). -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-runtime-reflection</artifactId>
		</dependency>
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-reflections</artifactId>
		</dependency>

		<!-- Bootstrap orchestrator (Bootstrap.builder() cold-start + SPI wiring). -->
		<dependency>
			<groupId>com.garganttua.core</groupId>
			<artifactId>garganttua-bootstrap</artifactId>
		</dependency>

		<!-- application.yaml parser — single jar, no transitive deps. -->
		<dependency>
			<groupId>org.yaml</groupId>
			<artifactId>snakeyaml</artifactId>
		</dependency>

		<!-- Test stack. -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>

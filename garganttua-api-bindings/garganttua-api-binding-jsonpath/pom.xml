<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.garganttua</groupId>
		<artifactId>garganttua-api-bindings</artifactId>
		<version>3.0.0-ALPHA01</version>
	</parent>
	<artifactId>garganttua-api-binding-jsonpath</artifactId>

	<description>Binding for Jayway JsonPath. The api migrates every
		class that imports com.jayway.jsonpath.* into this module so
		api-commons / api-core stay free of the dependency. Originally
		only the JWT security module used it (claims extraction).</description>

	<dependencies>
		<dependency>
			<groupId>com.garganttua</groupId>
			<artifactId>garganttua-api-commons</artifactId>
		</dependency>
		<dependency>
			<groupId>com.jayway.jsonpath</groupId>
			<artifactId>json-path</artifactId>
			<version>${json-path.version}</version>
		</dependency>
	</dependencies>
</project>
